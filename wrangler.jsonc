{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "coffee-time",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "none",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "coffee-time",
      "database_id": "187c7972-2e37-458e-ab8e-4f48d9630477",
      "migrations_dir": "db/migrations"
    }
  ],
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "coffee-time-media" }],
  "send_email": [{ "name": "EMAIL", "remote": true }],
  "triggers": { "crons": ["7 * * * *"] },
  // Online rooms for the Coffee Time game at /play. SQLite-backed, the kind the Workers Free plan allows.
  "durable_objects": { "bindings": [{ "name": "ROOMS", "class_name": "Room" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }],
  "vars": {
    "APP_ENV": "production",
    "SITE_URL": "https://www.playcoffeetime.com",
    "NOTIFY_TO": "smartzgraphics@yahoo.com",
    "NOTIFY_SMS_TO": "+15305747306",
    "MAIL_FROM": "Coffee Time <orders@playcoffeetime.com>"
  },
  // Secrets (set in the Worker's Settings or with `npx wrangler secret put NAME`, never in this file):
  //   HQ_SETUP_TOKEN   one-time phrase that unlocks /hq/setup until the first admin exists
  //   RESEND_API_KEY   turns on email alerts for orders and messages
  //   TWILIO_ACCOUNT_SID, TWILIO_AUTH_TOKEN, TWILIO_FROM  turn on text alerts for orders (NOTIFY_SMS_TO is the phone)
  //   MAIL_FROM        e.g. "Coffee Time <orders@playcoffeetime.com>" (domain verified in Resend)
  "observability": { "enabled": true },
  "workers_dev": true,
  "routes": [
    { "pattern": "www.playcoffeetime.com", "custom_domain": true },
    { "pattern": "playcoffeetime.com", "custom_domain": true }
  ]
}
