{
  "name": "coffee-time-website",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/gen-sql.mjs && node scripts/dev-server.mjs",
    "build": "node scripts/gen-sql.mjs",
    "seed": "python3 db/make-seed.py && node scripts/gen-sql.mjs",
    "check": "tsc --noEmit",
    "smoke": "node scripts/smoke.mjs",
    "shots": "node scripts/shots.mjs",
    "migrate:remote": "wrangler d1 migrations apply coffee-time --remote && wrangler d1 execute coffee-time --remote --file db/seed.sql",
    "deploy": "npm run build && wrangler deploy"
  },
  "devDependencies": {
    "typescript": "^5.9.0",
    "wrangler": "^4.20.0"
  }
}
